#!/usr/bin/env bash
# Versioned pre-commit hook: refuse private material, then the smoke test and
# every suite, against this checkout. Enable once per clone with
#   git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
bash "$root/tests/guard-private.sh" || exit 1
exec bash "$root/tests/run-all.sh"
